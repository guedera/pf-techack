# Na primeira execução, as imagens são resolvidas e fixadas em compose.lock.json.
JUICE_SHOP_IMAGE=bkimminich/juice-shop:latest
OLLAMA_IMAGE=ollama/ollama:latest
# Comece em loopback. Para a dupla, use o IP privado do Mac na LAN/VPN.
LAB_BIND_IP=127.0.0.1
JUICE_SHOP_PORT=3000
# API do modelo fica somente no Mac.
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:1.7b
# Ajustar após medir consumo; o padrão utiliza CPU no Docker Desktop/macOS.
OLLAMA_MEMORY=3g
OLLAMA_CPUS=3
